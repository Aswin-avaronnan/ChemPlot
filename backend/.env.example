# ==============================================================================
# ChemPlot Backend Environment Variables
# ==============================================================================

# Fast Local Dev Authentication Bypass (set false in production)
DEV_AUTH_BYPASS=true

# Database: SQLite for local dev, Neon Serverless Postgres for production
# Local Dev: sqlite:///./chemplot.db
# Production: postgresql://<user>:<password>@<neon-host>/<db-name>?sslmode=require
DATABASE_URL=sqlite:///./chemplot.db

# Clerk Authentication (Production)
CLERK_JWKS_URL=https://<clerk-domain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Cloudflare R2 Object Storage (Production)
# S3-API compatible, zero egress fees
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chemplot-raw-mpr-files
