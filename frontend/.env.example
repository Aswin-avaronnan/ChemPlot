# ==============================================================================
# ChemPlot Frontend Environment Variables
# ==============================================================================

# FastAPI Backend URL
# Local Dev: http://127.0.0.1:8000/api/v1
# Production (Render Web Service): https://chemplot-api.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# PostHog Product Analytics (Free Tier for PM Retain/Funnel Metrics)
# Get your Project API Key from app.posthog.com -> Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Clerk Authentication (Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
